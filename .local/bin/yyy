#!/usr/bin/env bash

## Trick yazi into using chafa backend

# Hide graphical session information
unset WAYLAND_DISPLAY
unset DISPLAY
unset XDG_SESSION_TYPE
unset XDG_SESSION_DESKTOP
unset XDG_CURRENT_DESKTOP
unset HYPRLAND_INSTANCE_SIGNATURE
unset TERM
unset TERM_PROGRAM
unset TERM_PROGRAM_VERSION

# export TERM=foot
# export TERM_PROGRAM=foot
# export XDG_SESSION_TYPE=dumb

yy() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd" || exit
  fi
  rm -vi --preserve-root -f -- "$tmp"
}
yy "$@"
