#!/usr/bin/env python3
"""Download YouTube videos with configurable quality and subtitles.

Uses the yt-dlp Python library directly (no subprocess for yt-dlp).
"""

from __future__ import annotations

import argparse
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass
from pathlib import Path
from typing import TextIO

try:
    import yt_dlp
except ImportError:
    print("yt-dlp could not be found. Please install it first.", file=sys.stderr)
    sys.exit(1)

QUALITY_FORMATS: dict[str, str] = {
    "1080p": "bestvideo[height<=1080]+bestaudio/best",
    "720p": "bestvideo[height<=720]+bestaudio/best",
    "480p": "bestvideo[height<=480]+bestaudio/best",
    "360p": "bestvideo[height<=360]+bestaudio/best",
    "240p": "bestvideo[height<=240]+bestaudio/best",
    "144p": "bestvideo[height<=144]+bestaudio/best",
}

SUBTITLE_LANGS: list[str] = ["en", "ar"]


@dataclass(frozen=True)
class DownloadConfig:
    url: str
    quality: str
    sub_lang: str
    youtube_dir: Path


def prompt_choice(
    title: str, options: list[str], prompt: str = "Enter choice: "
) -> str:
    """Show a numbered single-select menu; return the picked option."""
    while True:
        print(title)
        for i, opt in enumerate(options, 1):
            print(f"{i:2d}) {opt}")
        try:
            choice = int(input(prompt))
            return options[choice - 1]
        except (ValueError, IndexError):
            print("invalid option")


def prompt_multi_choice(title: str, options: list[str], prompt: str) -> str:
    """Show a numbered multi-select menu; return comma-joined picks."""
    print(title)
    for i, opt in enumerate(options, 1):
        print(f"{i:2d}) {opt}")

    selected = input(prompt).split()

    valid_items: list[str] = []
    for token in selected:
        if token.isdigit() and 1 <= int(token) <= len(options):
            valid_items.append(options[int(token) - 1])
        else:
            print(f"Skipping invalid selection: {token}")
            print("Defaulting to English")
            valid_items.append("en")

    return ",".join(valid_items)


def select_quality() -> str:
    picked = prompt_choice("Select video quality:", list(QUALITY_FORMATS) + ["Exit"])
    if picked == "Exit":
        sys.exit(0)
    return picked


def select_subtitles() -> str:
    return prompt_multi_choice(
        "Select subtitles:",
        SUBTITLE_LANGS,
        "Select multiple (e.g. 1 2): ",
    )


def display_time(seconds: int) -> str:
    """Convert a duration in seconds to a human-readable string."""
    days, rem = divmod(seconds, 86400)
    hours, rem = divmod(rem, 3600)
    minutes, secs = divmod(rem, 60)

    parts: list[str] = []
    if days > 0:
        parts.append(f"{days} days")
    if hours > 0:
        parts.append(f"{hours} hours")
    if minutes > 0:
        parts.append(f"{minutes} minutes")
    if secs > 0:
        parts.append(f"{secs} seconds")

    return " ".join(parts) if parts else "0 seconds"


class TeeLogger:
    """yt-dlp logger that mirrors every message to stdout and a log file."""

    def __init__(self, stream: TextIO) -> None:
        self._stream = stream

    def _emit(self, msg: object) -> None:
        print(msg)
        print(msg, file=self._stream)

    def debug(self, msg: object, *args, **kwargs) -> None:
        self._emit(msg)

    def info(self, msg: object, *args, **kwargs) -> None:
        self._emit(msg)

    def warning(self, msg: object, *args, **kwargs) -> None:
        self._emit(msg)

    def error(self, msg: object, *args, **kwargs) -> None:
        self._emit(msg)


def default_youtube_dir() -> Path:
    """Use ~/videos/youtube if it exists, else xdg-user-dir VIDEOS/youtube."""
    videos = Path.home() / "videos"
    if videos.is_dir():
        return videos / "youtube"
    result = subprocess.run(
        ["xdg-user-dir", "VIDEOS"], capture_output=True, text=True, check=True
    )
    return Path(result.stdout.strip()) / "youtube"


def build_outtmpl(output_dir: str, filename: str) -> dict[str, str]:
    """Per-type output templates so each artifact lands in its own folder."""
    return {
        "default": f"{output_dir}/{filename}",
        "thumbnail": f"{output_dir}/thumbnails/{filename}",
        "subtitle": f"{output_dir}/subtitles/{filename}",
        "description": f"{output_dir}/descriptions/{filename}",
        "infojson": f"{output_dir}/info/{filename}",
    }


def resolve_playlist_metadata(url: str) -> tuple[str, str] | None:
    """Extract playlist uploader/title for archive path, or None for single videos."""
    if "list=" not in url:
        return None
    ydl_opts = {
        "skip_download": True,
        "extract_flat": True,
    }
    with yt_dlp.YoutubeDL(ydl_opts) as ydl:
        info = ydl.extract_info(url, download=False, process=False)
    return info.get("playlist_uploader"), info.get("playlist_title")


def download(config: DownloadConfig, log_file: Path) -> int:
    """Run the download; returns 0 on success, non-zero on failure."""
    playlist_meta = resolve_playlist_metadata(config.url)

    if playlist_meta is not None:
        uploader, playlist_title = playlist_meta
        output_dir = f"{config.youtube_dir}/%(playlist_uploader)s/%(playlist_title)s"
        filename = "%(playlist_index&{}-|)s%(title)s.%(ext)s"
        actual_output_dir = config.youtube_dir / uploader / playlist_title
        archive_file = actual_output_dir / "archive.log"
    else:
        output_dir = f"{config.youtube_dir}/%(uploader)s/%(title)s"
        filename = "%(title)s.%(ext)s"
        archive_file = None

    finished_files: list[str] = []

    def hook(d: dict) -> None:
        if d.get("status") == "finished":
            finished_files.append(d["filepath"])

    ydl_opts = {
        "format": config.quality,
        "outtmpl": build_outtmpl(output_dir, filename),
        "ignoreerrors": True,
        "embed_metadata": True,
        "embed_chapters": True,
        "embedsubs": True,
        "embedthumbnail": True,
        "writedescription": True,
        "writethumbnail": True,
        "writeinfojson": True,
        "writesubtitles": True,
        "writeautomaticsub": True,
        "subtitleslangs": [lang for lang in config.sub_lang.split(",") if lang],
        "convertsubtitles": "srt",
        "convert_thumbnails": "png",
        "concurrent_fragment_downloads": 5,
        "merge_output_format": "mp4",
        "sponsorblockmark": "all",
        "postprocessor_hooks": [hook],
        "logger": TeeLogger(log_file.open("w", encoding="utf-8")),
    }

    if archive_file is not None:
        ydl_opts["download_archive"] = str(archive_file)

    start = time.monotonic()

    try:
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            ydl.download([config.url])
    except yt_dlp.utils.DownloadError as exc:
        print(f"Download failed: {exc}", file=sys.stderr)
        return 1

    if not finished_files:
        print("No files were downloaded.", file=sys.stderr)
        return 1

    # Save the URL next to the downloaded video
    download_dir = Path(finished_files[-1]).parent
    (download_dir / "url.txt").write_text(f"{config.url}\n", encoding="utf-8")

    print(f"The video was downloaded to: {download_dir}")
    elapsed = int(time.monotonic() - start)
    print(f"Elapsed time is: {display_time(elapsed)}")

    return 0


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="ytpy",
        description="Download YouTube videos with configurable quality and subtitles.",
    )
    parser.add_argument("url", help="video or playlist URL")
    parser.add_argument(
        "--dir",
        help="output directory (default: ~/videos/youtube or xdg-user-dir VIDEOS/youtube)",
    )
    quality = list(QUALITY_FORMATS)
    parser.add_argument(
        "--quality",
        choices=quality,
        help="video quality (prompts interactively if omitted)",
    )
    parser.add_argument(
        "--subs",
        nargs="+",
        choices=SUBTITLE_LANGS,
        help="subtitle languages (prompts interactively if omitted)",
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)

    youtube_dir = Path(args.dir) if args.dir else default_youtube_dir()
    youtube_dir.mkdir(parents=True, exist_ok=True)

    quality = args.quality if args.quality else QUALITY_FORMATS[select_quality()]
    sub_lang = ",".join(args.subs) if args.subs else select_subtitles()

    config = DownloadConfig(
        url=args.url,
        quality=quality,
        sub_lang=sub_lang,
        youtube_dir=youtube_dir,
    )
    return download(config, Path(tempfile.mkdtemp()) / "output.log")


if __name__ == "__main__":
    raise SystemExit(main())
